<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.hedspi.javafx.PainterController">
   <children>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="640.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <left>
            <VBox maxHeight="1.7976931348623157E308" spacing="8.0" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets right="8.0" />
               </BorderPane.margin>
               <children>
                  <TitledPane animated="false" maxWidth="1.7976931348623157E308" text="Tools">
                    <content>
                      <AnchorPane>
                           <children>
                              <RadioButton fx:id="penButton" layoutX="14.0" layoutY="14.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" text="Pen">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="drawingTool" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="eraserButton" layoutX="14.0" layoutY="43.0" mnemonicParsing="false" text="Eraser" toggleGroup="$drawingTool" />
                           </children>
                        </AnchorPane>
                    </content>
                     <font>
                        <Font size="13.0" />
                     </font>
                  </TitledPane>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearButtonPressed" text="Clear">
                     <font>
                        <Font size="13.0" />
                     </font></Button>
                  
               </children>
            </VBox>
         </left>
         <center>
            <Pane fx:id="drawingAreaPane" onMouseDragged="#drawingAreaMouseDragged" style="-fx-background-color: white;" BorderPane.alignment="CENTER" />
         </center></BorderPane>
   </children>
</AnchorPane>
