<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox prefHeight="-1.0" BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Options">
                            <items>
                                <Menu mnemonicParsing="false" text="Update Store">
                                    <items>
                                        <MenuItem mnemonicParsing="false" text="Add Book" />
                                        <MenuItem mnemonicParsing="false" text="Add CD" />
                                        <MenuItem mnemonicParsing="false" text="Add DVD" />
                                    </items>
                                </Menu>
                                <MenuItem mnemonicParsing="false" text="View Store" onAction="#menuViewStorePressed" />
                                <MenuItem mnemonicParsing="false" text="View Cart" onAction="#menuViewCartPressed" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <HBox prefHeight="30.0" style="-fx-background-color: #e0e0e0; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Button fx:id="btnStore" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0; -fx-background-radius: 0;" text="Store" HBox.hgrow="ALWAYS" onAction="#btnStorePressed" />
                        <Button mnemonicParsing="false" style="-fx-background-color: #f4f4f4; -fx-background-radius: 0;" text="Cart" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font></Button>
                    </children>
                </HBox>

                <Label text="CART" textFill="AQUA">
                    <font>
                        <Font size="50.0" />
                    </font>
                    <VBox.margin>
                        <Insets left="10.0" top="10.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </top>

    <center>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="-1.0" spacing="10.0">
                    <children>
                        <Label text="Filter:" />
                        <TextField fx:id="tfFilter" />
                        <RadioButton fx:id="radioBtnFilterId" selected="true" text="By ID">
                            <toggleGroup>
                                <ToggleGroup fx:id="filterCategory" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radioBtnFilterTitle" text="By Title" toggleGroup="$filterCategory" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </HBox>
                <TableView fx:id="tblMedia" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMediaTitle" prefWidth="75.0" text="Title" />
                        <TableColumn fx:id="colMediaCategory" prefWidth="75.0" text="Category" />
                        <TableColumn fx:id="colMediaCost" prefWidth="75.0" text="Cost" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <ButtonBar prefHeight="40.0" prefWidth="200.0">
                    <buttons>
                        <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#btnPlayPressed" text="Play" />
                        <Button fx:id="btnRemove" mnemonicParsing="false" onAction="#btnRemovePressed" text="Remove" />
                    </buttons>
                    <VBox.margin>
                        <Insets right="10.0" />
                    </VBox.margin>
                </ButtonBar>
            </children>
            <BorderPane.margin>
                <Insets left="10.0" />
            </BorderPane.margin>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="-1.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" prefHeight="-1.0" prefWidth="-1.0" spacing="10.0">
                    <children>
                        <Label text="Total:">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTotal" text="0 $" textFill="AQUA">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <Button fx:id="btnPlaceOrder" mnemonicParsing="false" style="-fx-background-color: red;" text="Place Order" textFill="WHITE" onAction="#btnPlaceOrderPressed">
                    <font>
                        <Font size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" top="50.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>
